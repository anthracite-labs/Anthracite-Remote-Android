<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".RemoteApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnthraciteRemote"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The SSH workspace surfaces are separate activities so the existing
             OpenCode journey keeps its single-Activity state machine untouched.
             None is exported: each is reachable only from this app. -->
        <activity
            android:name=".HostsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".WorkspaceActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density"
            android:exported="false" />

        <activity
            android:name=".FilesActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".GitActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".GitHubActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DeployActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".BootstrapActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- A terminal holds a live PTY and is not recreated on rotation: the
             activity keeps the channel and the emulator, and the renderer just
             re-measures its grid. -->
        <activity
            android:name=".terminal.TerminalActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
