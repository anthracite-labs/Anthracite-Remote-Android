<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/hosts_toolbar"
        style="@style/Widget.Anthracite.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/hosts_title" />

    <TextView
        android:id="@+id/hosts_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingTop="@dimen/space_s"
        android:text="@string/hosts_intro"
        android:textAppearance="@style/TextAppearance.Anthracite.Body" />

    <TextView
        android:id="@+id/hosts_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingVertical="@dimen/space_l"
        android:text="@string/hosts_empty"
        android:textAppearance="@style/TextAppearance.Anthracite.Body"
        android:visibility="gone" />

    <ListView
        android:id="@+id/hosts_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/outline_variant"
        android:dividerHeight="@dimen/stroke_thin" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/hosts_add"
        style="@style/Widget.Anthracite.Button.Cta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/screen_padding_h"
        android:text="@string/hosts_add"
        app:icon="@drawable/ic_server" />
</LinearLayout>
