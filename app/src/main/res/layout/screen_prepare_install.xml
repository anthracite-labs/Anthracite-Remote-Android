<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_prepare"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingVertical="@dimen/screen_padding_v">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prepare_title"
            android:textAppearance="@style/TextAppearance.Anthracite.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/web_password_body"
            android:textAppearance="@style/TextAppearance.Anthracite.Body" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/web_password_field"
            style="@style/Widget.Anthracite.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:hint="@string/web_password_hint"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/web_password_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:minHeight="@dimen/touch_target_min" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/web_password_confirm_field"
            style="@style/Widget.Anthracite.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/web_password_confirm_hint"
            app:endIconMode="password_toggle"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/web_password_confirm_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:minHeight="@dimen/touch_target_min" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/prepare_req_length_icon"
                android:layout_width="@dimen/icon_s"
                android:layout_height="@dimen/icon_s"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/prepare_req_length"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/prepare_require_length"
                android:textAppearance="@style/TextAppearance.Anthracite.MonoSmall" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/prepare_req_letter_icon"
                android:layout_width="@dimen/icon_s"
                android:layout_height="@dimen/icon_s"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/prepare_req_letter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/prepare_require_letter_digit"
                android:textAppearance="@style/TextAppearance.Anthracite.MonoSmall" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/prepare_req_match_icon"
                android:layout_width="@dimen/icon_s"
                android:layout_height="@dimen/icon_s"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/prepare_req_match"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/prepare_require_match"
                android:textAppearance="@style/TextAppearance.Anthracite.MonoSmall" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Anthracite.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/prepare_summary_title"
                    android:textAppearance="@style/TextAppearance.Anthracite.Label" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/prepare_summary_1"
                    android:textAppearance="@style/TextAppearance.Anthracite.Body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/prepare_summary_2"
                    android:textAppearance="@style/TextAppearance.Anthracite.Body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/prepare_summary_3"
                    android:textAppearance="@style/TextAppearance.Anthracite.Body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/prepare_summary_4"
                    android:textAppearance="@style/TextAppearance.Anthracite.Body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/prepare_note_linger"
                    android:textAppearance="@style/TextAppearance.Anthracite.MonoSmall" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prepare_confirm"
            style="@style/Widget.Anthracite.Button.Cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/cta_install_launch"
            app:icon="@drawable/ic_bolt" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prepare_cancel"
            style="@style/Widget.Anthracite.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_marginBottom="@dimen/space_l"
            android:text="@string/cancel" />
    </LinearLayout>
</ScrollView>
