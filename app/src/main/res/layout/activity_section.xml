<?xml version="1.0" encoding="utf-8"?>
<!-- Shared shell for Git, GitHub, deployment and provisioning screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/section_toolbar"
        style="@style/Widget.Anthracite.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <TextView
        android:id="@+id/section_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingVertical="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Anthracite.Body" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/section_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_s"
            android:paddingBottom="@dimen/space_xs" />
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/section_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <ListView
        android:id="@+id/section_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/outline_variant"
        android:dividerHeight="@dimen/stroke_thin" />

    <TextView
        android:id="@+id/section_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_l"
        android:textAppearance="@style/TextAppearance.Anthracite.Body"
        android:visibility="gone" />

    <TextView
        android:id="@+id/section_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:padding="@dimen/space_m"
        android:textAppearance="@style/TextAppearance.Anthracite.MonoSmall" />
</LinearLayout>
