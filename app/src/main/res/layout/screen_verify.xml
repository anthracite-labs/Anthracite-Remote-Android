<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_verify"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingVertical="@dimen/screen_padding_v">

        <ImageView
            android:id="@+id/verify_icon"
            android:layout_width="@dimen/icon_xl"
            android:layout_height="@dimen/icon_xl"
            android:layout_marginTop="@dimen/space_xl"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_shield"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/verify_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/host_key_title"
            android:textAppearance="@style/TextAppearance.Anthracite.Headline" />

        <TextView
            android:id="@+id/verify_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/verify_first_body"
            android:textAppearance="@style/TextAppearance.Anthracite.Body" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            style="@style/Widget.Anthracite.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_l">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/verify_server_label"
                    android:textAppearance="@style/TextAppearance.Anthracite.Label" />

                <TextView
                    android:id="@+id/verify_server_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textAppearance="@style/TextAppearance.Anthracite.Mono"
                    android:textIsSelectable="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/verify_key_type_label"
                    android:textAppearance="@style/TextAppearance.Anthracite.Label" />

                <TextView
                    android:id="@+id/verify_keytype_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textAppearance="@style/TextAppearance.Anthracite.Mono"
                    android:textIsSelectable="true" />

                <TextView
                    android:id="@+id/verify_saved_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/verify_saved_label"
                    android:textAppearance="@style/TextAppearance.Anthracite.Label"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/verify_saved_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:textAppearance="@style/TextAppearance.Anthracite.Mono"
                    android:textColor="@color/error"
                    android:textIsSelectable="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/verify_fingerprint_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/verify_fingerprint_label"
                    android:textAppearance="@style/TextAppearance.Anthracite.Label" />

                <TextView
                    android:id="@+id/verify_fingerprint_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:fontFamily="monospace"
                    android:textAppearance="@style/TextAppearance.Anthracite.Mono"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/verify_copy_button"
                    style="@style/Widget.Anthracite.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/verify_copy"
                    app:icon="@drawable/ic_content_copy" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/verify_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/verify_hint"
            android:textAppearance="@style/TextAppearance.Anthracite.MonoSmall" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_l"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/verify_decline_button"
                style="@style/Widget.Anthracite.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/verify_approve_button"
                style="@style/Widget.Anthracite.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:text="@string/approve" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
