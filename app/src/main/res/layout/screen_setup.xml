<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen_setup"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_h"
        android:paddingVertical="@dimen/screen_padding_v">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textAppearance="@style/TextAppearance.Anthracite.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/setup_body"
            android:textAppearance="@style/TextAppearance.Anthracite.Body" />

        <include
            android:id="@+id/setup_error_banner"
            layout="@layout/view_error_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/host_field"
            style="@style/Widget.Anthracite.TextField.Monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:hint="@string/label_host">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/host_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:minHeight="@dimen/touch_target_min" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/username_field"
            style="@style/Widget.Anthracite.TextField.Monospace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/label_username">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/username_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:minHeight="@dimen/touch_target_min" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/setup_section_auth"
            android:textAppearance="@style/TextAppearance.Anthracite.Label" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/auth_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/auth_password"
                style="@style/Widget.Anthracite.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/auth_password" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/auth_key"
                style="@style/Widget.Anthracite.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/auth_key" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/setup_auth_help"
            android:textAppearance="@style/TextAppearance.Anthracite.MonoSmall" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/password_field"
            style="@style/Widget.Anthracite.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/label_ssh_password"
            app:endIconMode="password_toggle"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/password_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:minHeight="@dimen/touch_target_min" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/key_button"
            style="@style/Widget.Anthracite.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/choose_key"
            app:icon="@drawable/ic_key" />

        <TextView
            android:id="@+id/key_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/no_key"
            android:textAppearance="@style/TextAppearance.Anthracite.MonoSmall" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passphrase_field"
            style="@style/Widget.Anthracite.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:hint="@string/label_passphrase"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passphrase_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:minHeight="@dimen/touch_target_min" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/setup_advanced_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/setup_section_advanced"
                android:textAppearance="@style/TextAppearance.Anthracite.Label" />

            <TextView
                android:id="@+id/setup_advanced_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.Anthracite.MonoSmall" />

            <ImageView
                android:id="@+id/setup_advanced_chevron"
                android:layout_width="@dimen/icon_m"
                android:layout_height="@dimen/icon_m"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_expand_more"
                app:tint="@color/on_surface_variant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/setup_advanced_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ssh_port_field"
                style="@style/Widget.Anthracite.TextField.Monospace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:hint="@string/label_ssh_port">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ssh_port_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/default_ssh_port" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/remote_port_field"
                style="@style/Widget.Anthracite.TextField.Monospace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:hint="@string/label_remote_port"
                app:helperText="@string/setup_help_existing_port"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/remote_port_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:minHeight="@dimen/touch_target_min"
                    android:text="@string/default_remote_port" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_button"
            style="@style/Widget.Anthracite.Button.Cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_l"
            android:text="@string/continue_action"
            app:icon="@drawable/ic_launch" />
    </LinearLayout>
</ScrollView>
