<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-activity shell. Screens are full-size siblings swapped by visibility
  (NavigationPolicy decides order and back targets). Edge-to-edge insets are
  applied as padding on this root, exactly as before the redesign.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <include layout="@layout/screen_welcome" />

    <include layout="@layout/screen_setup" />

    <include layout="@layout/screen_verify" />

    <include layout="@layout/screen_home" />

    <include layout="@layout/screen_prepare_install" />

    <include layout="@layout/screen_progress" />

    <include layout="@layout/screen_web" />

    <include layout="@layout/screen_manage" />
</FrameLayout>
