<?xml version="1.0" encoding="utf-8"?>
<!--
  A row used by hosts, files, Git, GitHub, containers and provisioning screens.
  `row_body` carries long mono content (a diff, logs, a PR description) so a
  screen never needs a second scroll container beside its list.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="@dimen/touch_target_min"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_l"
    android:paddingVertical="@dimen/space_m">

    <TextView
        android:id="@+id/row_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Anthracite.Title" />

    <TextView
        android:id="@+id/row_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xxs"
        android:textAppearance="@style/TextAppearance.Anthracite.MonoSmall" />

    <TextView
        android:id="@+id/row_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:background="@color/log_background"
        android:fontFamily="monospace"
        android:padding="@dimen/space_m"
        android:textAppearance="@style/TextAppearance.Anthracite.MonoSmall"
        android:textColor="@color/log_foreground"
        android:textIsSelectable="true"
        android:visibility="gone" />
</LinearLayout>
