    <!-- Welcome -->
    <string name="welcome_title">Your OpenCode, on your machine</string>
    <string name="welcome_body">Anthracite Remote connects this phone to OpenCode on your own Ubuntu server over SSH, then shows OpenCode\'s own WebUI through a protected tunnel. Your projects and provider credentials never leave Linux.</string>
    <string name="welcome_point_tunnel_title">Protected tunnel</string>
    <string name="welcome_point_tunnel_body">The WebUI is reached through an encrypted SSH tunnel bound to this phone\'s loopback interface. There is no Anthracite backend.</string>
    <string name="welcome_point_verify_title">Verified servers</string>
    <string name="welcome_point_verify_body">The server\'s SSH host key is checked before authentication. A changed key is refused until you approve it out of band.</string>
    <string name="welcome_point_private_title">Credentials stay yours</string>
    <string name="welcome_point_private_body">SSH credentials are encrypted with the Android Keystore. The WebUI password is never stored on this phone.</string>
    <string name="welcome_cta">Get started</string>
    <string name="welcome_footer">Direct SSH · pinned release · SHA-256 verified</string>

