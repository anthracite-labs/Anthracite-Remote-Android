    <!-- Prepare installation -->
    <string name="prepare_title">Prepare installation</string>
    <string name="web_password_title">WebUI password</string>
    <string name="web_password_body">Choose a password of at least 12 characters with a letter and a digit. It is sent over SSH and stored only on the Linux host. The WebUI username is opencode. This phone does not save it.</string>
    <string name="web_password_hint">WebUI password</string>
    <string name="web_password_confirm_hint">Confirm password</string>
    <string name="prepare_require_length">At least 12 characters</string>
    <string name="prepare_require_letter_digit">Contains a letter and a digit</string>
    <string name="prepare_require_match">Passwords match</string>
    <string name="prepare_error_mismatch">Use matching passwords of at least 12 characters with a letter and a digit.</string>
    <string name="prepare_summary_title">What happens next</string>
    <string name="prepare_summary_1">Preflight checks confirm Ubuntu 24.04, CPU architecture, disk space, and systemd --user on the server.</string>
    <string name="prepare_summary_2">The pinned OpenCode release is downloaded on the server and verified against its SHA-256 checksum.</string>
    <string name="prepare_summary_3">OpenCode is installed as your user\'s systemd service, bound to 127.0.0.1:4096 on the server.</string>
    <string name="prepare_summary_4">The phone checks that the service demands HTTP Basic authentication, opens the tunnel, and shows the WebUI.</string>
    <string name="prepare_note_linger">If persistence after logout or reboot needs an administrator action, the installer prints the exact command. It appears in the technical log.</string>

